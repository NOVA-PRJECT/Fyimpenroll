# =============================================================================
# FYIMP Course Registration System - Frontend Environment Configuration (.env)
# =============================================================================

# Backend API URL (Next.js server-side rewrites /api/* calls to this endpoint)
# In production on Vercel, set this to your Render/Railway backend URL (e.g. https://fyimp-backend.onrender.com)
BACKEND_URL=https://your-backend-service.onrender.com

# Supabase Public Keys (Required for client-side password reset and confirmation flows)
# Note: Main data queries and business mutations route through the NestJS backend via BACKEND_URL rewrites.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_public_key
