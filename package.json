{
  "name": "fyimp-course-registration",
  "version": "7.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "mobile",
    "contracts",
    "vendor/decode-uri-component"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "postinstall": "node scripts/apply-security-patches.cjs",
    "test:regression": "node --test tests/*.test.cjs frontend/tests/*.test.cjs",
    "test": "npm run build:backend && npm run test:regression"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "react": "19.2.3",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "concurrently": "^9.2.5"
  }
}
