{
  "name": "fyimp-course-registration",
  "version": "7.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "mobile",
    "contracts"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:backend": "npm run test --workspace=backend",
    "test:all": "npm run test:backend && npm run test:frontend && npm run lint && npm run build",
    "typecheck:frontend": "npm exec --workspace=frontend -- tsc --noEmit --incremental false",
    "lint": "npm run lint --workspace=frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "verify:clean": "node scripts/verify-clean-build.cjs",
    "test:mobile": "node --test mobile/test/*.test.cjs",
    "typecheck:mobile": "npm exec --workspace=mobile -- tsc --noEmit --incremental false",
    "verify:deploy": "node scripts/verify-clean-build.cjs --deploy"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "concurrently": "^9.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
