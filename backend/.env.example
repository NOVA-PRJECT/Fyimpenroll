# =============================================================================
# FYIMP Course Registration System - Backend Environment Configuration (.env)
# =============================================================================

# Server Environment
PORT=4000
NODE_ENV=production

# Frontend URL (Used for CORS whitelisting; comma-separated for multiple domains)
FRONTEND_URL=https://your-app-name.vercel.app

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_public_key

# Upstash Redis (Optional - Rate Limiting & Timetable Caching)
# Leave blank if not using Redis; the system will gracefully use in-memory fallbacks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
